<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>Ardalis.SmartEnum</PackageId>
		<Title>Ardalis.SmartEnum</Title>
		<Description>Classes to help produce strongly typed smarter enums in .NET.</Description>
		<Summary>Classes to help produce strongly typed smarter enums in .NET.</Summary>
		<PackageTags>enum;smartenum;ardalis</PackageTags>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReleaseNotes>
* Last MIT-licensed release. See https://nimbletools.io/news/ardalis-nuget-packages/
* Breaking: now targets net10.0, net11.0, and netstandard2.0 (dropped net6.0, net7.0, net8.0) (#583)
* Breaking (Ardalis.SmartEnum.EFCore): ConfigureSmartEnum() moved from the SmartEnum.EFCore namespace to Ardalis.SmartEnum.EFCore
* Each companion package now ships its own NuGet readme
* Updated dependencies to latest secure versions (#583)
* Null checks now consistently use pattern matching (#550)
* Corrected the documented exception type for FromValue (#549)
		</PackageReleaseNotes>
		<AssemblyName>Ardalis.SmartEnum</AssemblyName>
		<PackageReadmeFile>readme-nuget.md</PackageReadmeFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DefineConstants>TRACE;DEBUG</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<Folder Include="Properties\PublishProfiles\" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\..\readme-nuget.md" Link="readme-nuget.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="$(SolutionDir)img\icon.png" Pack="true" Visible="false" PackagePath="" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netStandard2.0'">
	  <PackageReference Include="System.ComponentModel.Annotations" />
	</ItemGroup>
</Project>
